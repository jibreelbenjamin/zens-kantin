# =====================================================================
# Zen's Kantin — contoh environment variables
# =====================================================================
# Salin berkas ini jadi `.env`, lalu isi nilainya:
#
#   cp .env.example .env
#
# `.env` berisi kredensial asli dan TIDAK boleh ikut ter-commit.
# Penjelasan lengkap tiap variabel ada di README bagian 7.
# =====================================================================


# ---------------------------------------------------------------------
# SUPABASE (WAJIB)
# Ambil dari Supabase Dashboard > Project Settings > API.
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — HANYA untuk server, jangan pernah dipakai di kode
# client. Di project ini sudah diisolasi di src/lib/supabase/server.ts
# (createAdminClient), yang cuma diimpor dari Route Handler & Server
# Component, tidak pernah dari file "use client".
# Dipakai untuk: login username/password, set password saat onboarding,
# dan semua operasi tulis admin yang melewati RLS.
SUPABASE_SERVICE_ROLE_KEY=


# ---------------------------------------------------------------------
# IDENTITAS & URL APLIKASI
# ---------------------------------------------------------------------
# Nama/brand aplikasi — dipakai di SELURUH UI (judul tab browser, halaman
# login/onboarding, sidebar admin & kasir, hasil ekspor laporan, dst).
# Ganti nilai ini kalau mau memakai nama lain, tidak perlu ubah kode.
NEXT_PUBLIC_APP_NAME="Zen's Kantin"

# URL publik aplikasi, TANPA slash di akhir — dipakai untuk membuat tautan
# absolut di dalam email (tombol "Buka Aplikasi", link ke halaman admin).
# Kalau dikosongkan, email tetap terkirim tapi tanpa tombol tautan.
APP_URL="http://localhost:3000"


# ---------------------------------------------------------------------
# MODE PEMELIHARAAN
# ---------------------------------------------------------------------
# Set "true" untuk mematikan sementara SELURUH akses aplikasi (admin,
# kasir, pelanggan, bahkan yang belum login) — semua request dialihkan ke
# halaman pemeliharaan. Set balik ke "false" (atau hapus) untuk
# mengaktifkan lagi. Butuh restart/redeploy server supaya terbaca; ini
# bukan setting yang bisa diubah dari UI.
APP_LOCKDOWN=false


# ---------------------------------------------------------------------
# EMAIL — Gmail SMTP + App Password (OPSIONAL)
# ---------------------------------------------------------------------
# Dipakai untuk: email ke klien saat status akun disetujui/diblokir, email
# ke admin saat ada pendaftaran akun baru, dan laporan bulanan ke admin.
# Kalau dua variabel ini dikosongkan, fitur email nonaktif (fitur lain
# tetap jalan normal, kegagalannya cuma dicatat di log server) —
# lihat src/lib/mail.ts.
#
# Cara mendapatkan GMAIL_APP_PASSWORD (BUKAN password akun Gmail biasa):
#   1. Aktifkan Verifikasi 2 Langkah di akun Gmail pengirim:
#      https://myaccount.google.com/signinoptions/two-step-verification
#   2. Buka https://myaccount.google.com/apppasswords, buat App Password
#      baru (nama bebas, mis. "Zen's Kantin"), pilih app "Mail".
#   3. Salin 16 karakter yang muncul (boleh dengan/tanpa spasi) ke bawah.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""


# ---------------------------------------------------------------------
# CRON (OPSIONAL)
# ---------------------------------------------------------------------
# Token rahasia untuk endpoint /api/cron/* (pembersihan gambar tidak
# terpakai & laporan bulanan) — dipanggil dari CRONTAB DI SERVER, bukan
# dari browser, jadi diproteksi token ini lewat header Authorization,
# bukan sesi login.
# Isi dengan string acak yang panjang, mis. hasil `openssl rand -hex 32`.
# Kalau dikosongkan, kedua endpoint cron nonaktif total (fail-closed).
CRON_SECRET=""

# Contoh crontab di server (jalankan `crontab -e`) — perhatikan -X POST,
# kedua endpoint ini hanya menerima POST:
#   # Bersihkan gambar tidak terpakai tiap hari jam 3 pagi
#   0 3 * * * curl -fsS -X POST https://domain-kamu/api/cron/cleanup-orphan-images -H "Authorization: Bearer TOKEN_CRON_SECRET_KAMU"
#   # Kirim laporan bulanan tanggal 1 tiap bulan jam 7 pagi
#   0 7 1 * * curl -fsS -X POST https://domain-kamu/api/cron/monthly-report -H "Authorization: Bearer TOKEN_CRON_SECRET_KAMU"


# ---------------------------------------------------------------------
# PRISMA MIGRATE (OPSIONAL)
# ---------------------------------------------------------------------
# HANYA dibutuhkan kalau mau menjalankan migrasi database lewat Prisma
# (npm run db:migrate) alih-alih paste manual ke Supabase SQL Editor.
# Tidak dipakai sama sekali saat aplikasi berjalan — query aplikasi
# lewat @supabase/supabase-js, bukan Prisma Client.
#
# Ambil dari Supabase Dashboard > Project Settings > Database:
#   DATABASE_URL -> "Connection pooling" (port 6543, mode transaction)
#   DIRECT_URL   -> "Connection string" langsung (port 5432, tanpa pooling)
#
# Prisma Migrate menjalankan semua DDL lewat DIRECT_URL (dideklarasikan
# sebagai directUrl di prisma/schema.prisma), karena transaction pooler
# tidak mendukung DDL — jadi DIRECT_URL wajib port 5432.
DATABASE_URL=""
DIRECT_URL=""
